# =============================================================================
# Express.js Application Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# This file is committed to version control as documentation.
# The actual .env file should NEVER be committed (it contains secrets).
#
# dotenv compatible format: KEY=value
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js/Express Core Configuration
# -----------------------------------------------------------------------------

# Environment mode: development, production, or test
# Controls logging verbosity, error detail exposure, and other environment-specific behavior
NODE_ENV=development

# Secret key for session management and cryptographic operations
# IMPORTANT: Generate a secure random key for production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=your-super-secret-key-change-in-production

# Enable/disable debug mode (typically controlled by NODE_ENV)
# Set to 'true' or 'false'
DEBUG=true

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Host address to bind the Express server
# Use 0.0.0.0 to accept connections from all network interfaces
HOST=0.0.0.0

# Port number for the Express server
PORT=3000

# -----------------------------------------------------------------------------
# Request/Response Configuration
# -----------------------------------------------------------------------------

# Maximum request body size (for body-parser middleware)
# Accepts values like: 100kb, 1mb, 10mb
REQUEST_LIMIT=10mb

# Minimum response size for compression (for compression middleware)
# Responses smaller than this threshold will not be compressed
COMPRESSION_THRESHOLD=1kb

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# CORS allowed origins (comma-separated list)
# Use * for development, specific domains for production
CORS_ORIGINS=*

# JWT secret key for token-based authentication (if using JWT)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# JWT token expiration time in seconds (default: 1 hour)
JWT_ACCESS_TOKEN_EXPIRES=3600

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Logging level: error, warn, info, http, verbose, debug, silly
# Winston logging levels (lowercase for Node.js convention)
LOG_LEVEL=info

# Log format: json, simple, combined
# json: Structured JSON output (recommended for production)
# simple: Human-readable colorized output (recommended for development)
# LOG_FORMAT=simple

# -----------------------------------------------------------------------------
# Optional External Services
# -----------------------------------------------------------------------------

# Redis URL for caching/sessions (if using Redis)
# REDIS_URL=redis://localhost:6379/0

# Email configuration (if using nodemailer)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=your-email-password
