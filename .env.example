# =============================================================================
# Flask Application Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# This file is committed to version control as documentation.
# The actual .env file should NEVER be committed (it contains secrets).
#
# Python-dotenv compatible format: KEY=value
# =============================================================================

# -----------------------------------------------------------------------------
# Flask Core Configuration
# -----------------------------------------------------------------------------

# Flask application entry point (required for 'flask' CLI commands)
FLASK_APP=app.py

# Environment mode: development, production, or testing
# Controls debug mode, logging verbosity, and other environment-specific behavior
FLASK_ENV=development

# Secret key for session management and cryptographic operations
# IMPORTANT: Generate a secure random key for production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# Enable/disable debug mode (automatically set based on FLASK_ENV in most cases)
# Set to 'true' or 'false'
DEBUG=true

# Enable/disable testing mode
# Set to 'true' or 'false'
TESTING=false

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Host address to bind the Flask server
# Use 0.0.0.0 to accept connections from all network interfaces
HOST=0.0.0.0

# Port number for the Flask server
PORT=5000

# Number of Gunicorn workers for production deployment
# Recommended: (2 x CPU cores) + 1
GUNICORN_WORKERS=4

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Database connection URL (SQLAlchemy format)
# Examples:
#   SQLite:     sqlite:///app.db
#   PostgreSQL: postgresql://user:password@localhost:5432/dbname
#   MySQL:      mysql+pymysql://user:password@localhost:3306/dbname
DATABASE_URL=sqlite:///app.db

# SQLAlchemy-specific configuration
# Track modifications of objects (set to false for performance in production)
SQLALCHEMY_TRACK_MODIFICATIONS=false

# Echo SQL queries to console (useful for debugging, disable in production)
SQLALCHEMY_ECHO=false

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------

# CORS allowed origins (comma-separated list)
# Use * for development, specific domains for production
CORS_ORIGINS=*

# JWT secret key for token-based authentication (if using JWT)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# JWT token expiration time in seconds (default: 1 hour)
JWT_ACCESS_TOKEN_EXPIRES=3600

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format (optional)
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# -----------------------------------------------------------------------------
# Optional External Services
# -----------------------------------------------------------------------------

# Redis URL for caching/sessions (if using Redis)
# REDIS_URL=redis://localhost:6379/0

# Email configuration (if using Flask-Mail)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=your-email-password

# -----------------------------------------------------------------------------
# Application-Specific Configuration
# -----------------------------------------------------------------------------

# JSON response configuration
# Sort keys in JSON responses (set to false for performance)
JSON_SORT_KEYS=false

# Maximum content length for requests (in bytes)
# Default: 16 MB
MAX_CONTENT_LENGTH=16777216
